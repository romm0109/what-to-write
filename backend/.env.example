# No API keys needed for the CLI itself.
# Embeddings run locally via @xenova/transformers.
#
# Default CLI provider:
# LLM_CLI_PROVIDER=crush
#
# Optional generic override for crush:
# LLM_CLI_MODEL=zai/glm-4.5
#
# Optional crush-specific settings:
# CRUSH_CLI_PATH=crush
# CRUSH_MODEL=zai/glm-4.5
#
# Optional Gemini fallback:
# GEMINI_CLI_PATH=gemini
# GEMINI_MODEL=gemini-2.5-flash
